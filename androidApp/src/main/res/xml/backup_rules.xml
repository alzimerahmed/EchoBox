<?xml version="1.0" encoding="utf-8"?><!--
   Legacy full-backup rules for devices older than API 31.
   Mirrors data_extraction_rules.xml: exclude everything. The datastore dir holds
   session credentials (YouTube cookie, Last.fm session key) and must never leave
   the device via platform autobackup; the app's own .backup zip is the supported
   backup path.
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
